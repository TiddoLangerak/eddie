{
  "name": "@tiddo/eddie-ui",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --conditions=development src/**/*.test.ts",
    "test:e2e": "NODE_OPTIONS='--experimental-strip-types --conditions=development' playwright test",
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "serve": "./serve"
  },
  "dependencies": {
    "@tiddo/beancount-types": "*",
    "@tiddo/beancount-parser": "*",
    "@tiddo/beancount-formatter": "*",
    "@tiddo/eddie-parry": "*",
    "@tiddo/eddie-utils": "*"
  }
}
