{
  "name": "@tiddo/beancount-types",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b"
  }
}
